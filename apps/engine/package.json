{
    "name": "@bot/engine",
    "version": "0.0.1",
    "private": true,
    "description": "NestJS trading engine — strategy, risk gate, execution, persistence.",
    "scripts": {
        "build": "nest build",
        "dev": "nest start --watch",
        "start": "node dist/main.js",
        "start:dev": "nest start --watch",
        "start:prod": "node dist/main.js",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "test": "jest",
        "typecheck": "tsc --noEmit",
        "typeorm": "typeorm-ts-node-commonjs -d src/database/dataSource.ts",
        "migration:generate": "pnpm typeorm migration:generate",
        "migration:run": "pnpm typeorm migration:run",
        "migration:revert": "pnpm typeorm migration:revert"
    },
    "dependencies": {
        "@nestjs/common": "11.1.23",
        "@nestjs/config": "4.0.4",
        "@nestjs/core": "11.1.23",
        "@nestjs/event-emitter": "3.1.0",
        "@nestjs/platform-express": "11.1.23",
        "@nestjs/schedule": "6.1.3",
        "@nestjs/typeorm": "11.0.1",
        "class-transformer": "0.5.1",
        "class-validator": "0.15.1",
        "decimal.js": "10.6.0",
        "dotenv": "16.4.7",
        "nestjs-pino": "4.6.1",
        "pg": "8.21.0",
        "pino": "10.3.1",
        "pino-http": "11.0.0",
        "reflect-metadata": "0.2.2",
        "rxjs": "7.8.2",
        "typeorm": "1.0.0"
    },
    "devDependencies": {
        "@nestjs/cli": "11.0.21",
        "@nestjs/schematics": "11.1.0",
        "@nestjs/testing": "11.1.23",
        "@types/express": "5.0.0",
        "@types/jest": "29.5.14",
        "@types/node": "22.19.19",
        "jest": "29.7.0",
        "pino-pretty": "13.1.3",
        "ts-jest": "29.2.5",
        "ts-node": "10.9.2",
        "tsconfig-paths": "4.2.0",
        "typescript": "5.9.3"
    }
}
