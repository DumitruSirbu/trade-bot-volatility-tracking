# =============================================================================
# Trade-bot environment template.
# Copy to `.env` and fill in real values. `.env` is gitignored — NEVER commit it.
# No real secret may ever appear here; only placeholders / safe local defaults.
#
# Dev workflow (M10+):
#   1. cp .env.example .env  (fill in EXCHANGE_*, TELEGRAM_*, AUTH_* secrets)
#   2. docker compose up --build
#   3. open http://localhost:8080  → LoginScreen → paste AUTH_BOOTSTRAP_SECRET
#   Postgres + engine + dashboard come up in order; engine waits for
#   postgres healthy, dashboard waits for engine healthy.
#
#   Adminer (DB admin UI) is OPT-IN via the `dev` profile so it's never
#   published by accident in shared environments:
#     docker compose --profile dev up -d            # brings up adminer too
#     docker compose --profile dev up -d adminer    # adminer only
#
#   Prod / CI image builds (no pretty logs, fully reproducible):
#     docker compose build --build-arg INCLUDE_DEV_LOGS=false engine
#
#   Migrations: the `engine-migrator` one-shot compose service runs
#   `typeorm migration:run` against the compiled JS DataSource and exits.
#   The engine service waits on `service_completed_successfully` before
#   booting, so a fresh `docker compose up` always lands a schema-correct DB.
#   Stand-alone host dev (`pnpm engine:dev`) still uses the existing CLI:
#     pnpm --filter @bot/engine migration:run
# =============================================================================

# -----------------------------------------------------------------------------
# Runtime
# -----------------------------------------------------------------------------
NODE_ENV=development
# Host-side port mapped to the engine container's :3000 (used for direct curl
# and the operator CLI). The dashboard NEVER addresses this — it goes through
# the in-network nginx reverse-proxy. Compose pins the in-container port to 3000.
ENGINE_PORT=3000
# Log level for the structured logger: error | warn | log | debug | verbose.
LOG_LEVEL=debug
# M11a W1.10 — Number of upstream proxy hops to trust for X-Forwarded-For.
# PINNED to 0 for the M11a local soak: there is NO external reverse proxy in
# front of the engine, so any X-Forwarded-For header on an inbound request is
# untrusted by definition. M11b (cloud topology) introduces an external proxy
# and will bump this with an explicit ADR amendment. Do NOT change this value
# while running on a single trusted host — a non-zero value lets a peer on the
# host spoof source IPs and defeat the login rate-limiter's per-IP window.
TRUSTED_PROXY_HOPS=0
# Legacy alias kept for back-compat (AppConfigService reads TRUST_PROXY_HOPS).
# When both are set the engine reads TRUST_PROXY_HOPS; keep them in sync.
TRUST_PROXY_HOPS=0

# -----------------------------------------------------------------------------
# Database — Postgres
# Compose builds the container from DB_* below.
# Engine (TypeORM) connects via DATABASE_URL.
# When running ON THE HOST (pnpm engine:dev), host = localhost.
# When running INSIDE compose, the engine service overrides DB_HOST=postgres.
# -----------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_USER=trade_bot
DB_PASSWORD=change_me_local_only
DB_NAME=trade_bot
DATABASE_URL=postgresql://trade_bot:change_me_local_only@localhost:5432/trade_bot

# -----------------------------------------------------------------------------
# Automated daily DB backup (M17 — ADR-tracked in docs/plans/M17-daily-db-backup.md)
# In-engine NestJS scheduler dumps the soak DB (DATABASE_URL) once per UTC day
# via the bundled pg_dump (postgresql18-client), gzips it, and keeps the
# DB_BACKUP_RETENTION newest dumps. Read-only — never mutates the DB. This
# AUTOMATES, and does not replace, the CLAUDE.md rule-9 manual `backup_*` dump;
# the two filename prefixes coexist (auto = `trade_bot_<UTC>.sql.gz`, manual =
# `backup_*`), and retention only ever prunes the automated `trade_bot_*` files.
#
# DB_BACKUP_DIR — directory the engine writes dumps to. Its meaning depends on
# where the engine runs:
#
#   | Run context              | DB_BACKUP_DIR the engine uses | Notes                         |
#   | ------------------------ | ---------------------------- | ----------------------------- |
#   | compose engine container | /var/backups/trade-bot       | set as an engine.environment  |
#   |                          |   (fixed; host side = this    |   override in docker-compose; |
#   |                          |    var, bind-mounted)         |   host path = DB_BACKUP_DIR    |
#   | host dev (pnpm engine:dev) | ./backups                  | rely on rule-9 manual dump;   |
#   |                          |                              |   keep DB_BACKUP_ENABLED=false |
#   | cloud                    | S3-class object store        | OUT OF SCOPE for M17           |
#
# In compose, the host side of the bind mount is THIS value (./backups by
# default). The runtime container runs as uid 1000 (`node`), and a freshly
# created host ./backups is often root-owned, so the engine cannot write to it
# until the operator makes it writable by uid 1000 (review H4):
#   mkdir -p ./backups && chown 1000:1000 ./backups
DB_BACKUP_DIR=./backups
# Feature flag. `true` here is intended for compose SOAK runs (the engine image
# carries pg_dump). Host dev (`pnpm engine:dev`) does NOT provision a host
# pg_dump client in M17 — set this to `false` there and rely on the rule-9
# manual dump. Test/CI keep it false (see .env.test.example + ci.yml).
DB_BACKUP_ENABLED=true
# Daily schedule — standard 5-field cron, evaluated in UTC. 03:00 UTC is offset
# from the 00:00 PnL-summary / overnight-partition crons to keep contention low
# for the read-only dump.
DB_BACKUP_CRON=0 3 * * *
# Number of dumps to keep (current + previous). Older `trade_bot_*` dumps are
# pruned; manual `backup_*` dumps are never counted toward — nor pruned by — this.
DB_BACKUP_RETENTION=3

# Adminer DB-inspection UI (host port → container 8080).
ADMINER_PORT=8081

# -----------------------------------------------------------------------------
# Dashboard
# -----------------------------------------------------------------------------
# Host-side port mapped to the dashboard nginx container.
DASHBOARD_PORT=8080

# -----------------------------------------------------------------------------
# Exchange — Binance USDT-M Futures (TESTNET first; least-privilege, NO withdrawals)
# Leave blank until you create restricted testnet keys. Never paste live keys here.
# -----------------------------------------------------------------------------
EXCHANGE_API_KEY=
EXCHANGE_API_SECRET=

# M11a R1.3 (ADR 0032 §D6/§D7/§D8) — primary exchange-environment selector.
# NO default. Engine refuses to start when this is unset. Valid values:
#   testnet — testnet.binancefuture.com (regression / smoke only; key-permission
#             assertion is EXEMPT on testnet — Binance does not surface
#             restrictions endpoints there).
#   paper   — engine-local paper trading against live fapi.binance.com market
#             data. Order intents are intercepted by PaperExecutionClient and
#             never leave the process. REQUIRES a dedicated zero-balance
#             Binance USDT-M Futures sub-account key with
#             { enableReading: true, enableFutures: true }, IP-restricted,
#             trading-authority expiry set. The D13 nullity probe asserts the
#             sub-account holds zero balance + zero positions + zero open
#             orders at every reconciliation tick. See the soak runbook
#             (docs/plans/M11a-local-soak.md) and ADR 0032 §D8 Fallback Profile
#             for the sub-account creation procedure.
#   live    — fapi.binance.com (real money). Requires LIVE_GO_AHEAD_TOKEN_FILE +
#             LIVE_GO_AHEAD_TOKEN_HASH set + matching content — two-token boot.
EXCHANGE_ENV=

# M11a W1.1 — two-token live-mode boot. Only required when EXCHANGE_ENV=live.
# LIVE_GO_AHEAD_TOKEN_FILE points to a local file the operator must drop on
# disk to opt into live trading; LIVE_GO_AHEAD_TOKEN_HASH is the hex SHA-256
# of that file's trimmed content, baked into config at build time. Both halves
# must agree or boot aborts. PAPER does NOT use this gate (ADR 0032 §D9).
LIVE_GO_AHEAD_TOKEN_FILE=
LIVE_GO_AHEAD_TOKEN_HASH=

# M11a R1.5 (ADR 0032 §D6/§D7) — boot-mode transition tokens. Each transition
# between EXCHANGE_ENV values is single-use and gated by a separate file +
# hash pair (analogous to LIVE_GO_AHEAD). Only the pair matching the actual
# transition direction is consulted; mismatched pairs are ignored. A leaked
# token file alone is not enough — the operator-baked SHA-256 hash must match
# the file's trimmed content. Documented transitions only (D7 matrix):
#
#   TESTNET -> PAPER : TESTNET_TO_PAPER_TOKEN_FILE + TESTNET_TO_PAPER_TOKEN_HASH
#   PAPER   -> LIVE  : PAPER_TO_LIVE_TOKEN_FILE   + PAPER_TO_LIVE_TOKEN_HASH
#                      (additionally requires LIVE_GO_AHEAD_TOKEN_FILE/HASH)
#
# Other rows in the D7 matrix (TESTNET<->LIVE, PAPER<->TESTNET, LIVE->PAPER,
# LIVE->TESTNET) are operator-runbook-gated and will land in later waves —
# their env-var names are reserved here for cross-reference, but the engine
# does not yet read them.
TESTNET_TO_PAPER_TOKEN_FILE=
TESTNET_TO_PAPER_TOKEN_HASH=
PAPER_TO_LIVE_TOKEN_FILE=
PAPER_TO_LIVE_TOKEN_HASH=

# Legacy (pre-M11a). Retained for back-compat; new code branches on
# EXCHANGE_ENV. Leave at `true` unless an old consumer still reads it.
EXCHANGE_TESTNET=true

# -----------------------------------------------------------------------------
# Telegram notifications (alert sink — outbound only)
# -----------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# -----------------------------------------------------------------------------
# Auth (M9 + M10)
# All three AUTH_* secrets MUST be set in production. In development, leaving
# AUTH_HMAC_SECRET / AUTH_BOOTSTRAP_SECRET unset will generate per-process
# random values (and emit a warning) — fine for local, fatal in prod.
# -----------------------------------------------------------------------------
# HS256 signing key for engine-issued JWTs. >= 32 bytes random hex/base64.
# Generate: `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
AUTH_HMAC_SECRET=

# Shared bootstrap secret the operator types into the dashboard LoginScreen
# to obtain a session JWT (ADR 0027). >= 32 bytes, MUST differ from
# AUTH_HMAC_SECRET (key-reuse forbidden — engine boot-fails). Treat as a
# long-lived credential: keep in a password manager, rotate manually.
AUTH_BOOTSTRAP_SECRET=

# Comma-separated scopes minted into a login-issued token (default `read,halt`).
# `admin` is rejected at boot — admin tokens are CLI-issued only (ADR 0027 §2.2).
AUTH_LOGIN_SCOPES=read,halt

# Allowed Origin values for the engine's CORS interceptor (comma-separated).
# Must include the dashboard's origin. Empty = deny all (ADR 0020 §2.3).
# Dev: include the Vite dev server too.
AUTH_CORS_ALLOWLIST=http://localhost:8080,http://localhost:5173

# Legacy / CLI bearer token. Unused by the dashboard once login lands.
API_AUTH_TOKEN=

# -----------------------------------------------------------------------------
# Kill switch defaults
# -----------------------------------------------------------------------------
# Default value of the `flattenOpenPositions` checkbox on the kill-switch
# confirm dialog. ADR 0021 §2.4 mandates `false` — overriding to `true`
# changes server semantics and requires an ADR amendment.
KILL_SWITCH_FLATTEN_DEFAULT=false

# -----------------------------------------------------------------------------
# Risk limits — conservative defaults. Live starts at the most restricted profile.
# -----------------------------------------------------------------------------
# Architectural max is 3; live starts at 1.
MAX_OPEN_POSITIONS=1
# Max notional exposure per coin (USDT).
MAX_EXPOSURE_PER_COIN_USDT=100
# Daily realized-loss limit (USDT) — halts new entries when breached.
DAILY_LOSS_LIMIT_USDT=50
# Weekly realized-loss limit (USDT).
WEEKLY_LOSS_LIMIT_USDT=200
# Net same-direction exposure ceiling across symbols (USDT).
MAX_SAME_DIRECTION_EXPOSURE_USDT=200
# Cooldown after a losing trade before re-entry is allowed (milliseconds).
COOLDOWN_AFTER_LOSS_MS=900000
# Total account capital allocated to the bot (USDT). Live starts at 500–1000.
ACCOUNT_CAPITAL_USDT=500
# M23 — auto-resume breadth-triggered market_stress halts after 3 consecutive
# clean inner-band ticks. Defaults: paper=true, live=false. Set explicitly to
# override. Has no effect on loss halts or non-breadth stress legs.
MARKET_STRESS_AUTO_RESUME_ENABLED=

# -----------------------------------------------------------------------------
# Strategy
# -----------------------------------------------------------------------------
# Active strategy_versions.id the engine runs (ADR 0003 §7). 1 = v0 no-trade baseline.
# Switching the active version is a config change + restart — no code change.
ACTIVE_STRATEGY_VERSION_ID=1

# Execution mode: dry-run | live (controls whether the ExecutionModule
# actually hits the exchange order API — ADR 0011).
EXECUTION_MODE=dry-run

# -----------------------------------------------------------------------------
# Analysis MCP (M12 — ADR 0033 + 0034)
# -----------------------------------------------------------------------------
# The MCP server (`apps/mcp/`) is a stdio-launched read-only analytical
# surface for an LLM agent. It connects to Postgres under a dedicated
# least-privilege role `mcp_reader` (ADR 0034) — NEVER the engine's
# writer connection. Required only when launching `node apps/mcp/dist/main.js`;
# the engine + dashboard ignore these vars.
#
# Bootstrap (one-time, per `docs/runbooks/mcp-deployment.md`):
#   1. Run the engine migrations so the role exists.
#   2. Rotate the sentinel password:
#        docker exec -i trade-bot-postgres psql -U <admin> -d <db> \
#          -c "ALTER ROLE mcp_reader PASSWORD '<your-secret>';"
#   3. Set MCP_DB_PASSWORD below to the same secret.
#   `DataSourceFactory` refuses to boot if MCP_DB_PASSWORD still equals the
#   sentinel string `mcp_reader_change_me_at_deploy`.
MCP_DB_HOST=localhost
# trade-bot-postgres is published on host port 5433 (in-container 5432); the
# in-container engine uses 5432 directly. Adjust if you're launching MCP from
# inside the docker network.
MCP_DB_PORT=5433
MCP_DB_NAME=
MCP_DB_USER=mcp_reader
MCP_DB_PASSWORD=

# Optional TLS — only `verify-full` or `verify-ca` accepted (insecure modes
# rejected). Leave empty for local non-TLS Postgres.
MCP_DB_SSL=

# Optional absolute path to the engine launcher used by the `run_backtest`
# tool (ADR 0033 §2.5 Option II spawn). If unset, MCP falls back to `pnpm`
# resolved via PATH (acceptable on developer machines, not production).
# Validated at boot: must be absolute + exist.
MCP_ENGINE_CMD=

# Optional escape hatch — set to `disabled` ONLY in tests. The boundary
# guard scans require.cache for /apps/engine/ paths and process.exit(1)s
# if any match. Never disable in operator runs.
MCP_BOUNDARY_GUARD=

# -----------------------------------------------------------------------------
# M13 agent (ADR 0035 + 0036 + 0037 + 0038)
# -----------------------------------------------------------------------------
# The agent (`apps/agent/`) is a weekly outer-loop batch job that proposes
# strategy-version drafts via the Vercel AI SDK. It is structurally isolated
# from the engine, MCP server, and analysis package: it reads via the MCP
# HTTP transport (network client only) and writes a single `status='draft'`
# row via the `agent_writer` SDF (ADR 0036). Launched on-demand:
#   docker compose --profile agent run --rm bot-agent
#
# All AGENT_* + AI_GATEWAY_* vars below are batch-launch-only — the engine
# and dashboard never read them.
#
# M13 W5.B — bot-agent runs `sleep infinity` as PID1 so the ofelia sidecar
# (`bot-agent-cron`) can trigger the weekly outer-loop via `docker exec`. The
# cron schedule (Sun 00:00 UTC) lives on container labels in docker-compose.yml.
# To run manually:
#   docker compose --profile agent up -d
#   docker compose --profile agent exec bot-agent \
#       node dist/main.js --week-iso 2026-W22 --parent-version-id <N> --dry-run

# Postgres credentials for the dedicated `agent_writer` role (ADR 0036).
# NEVER the engine's writer role. AGENT_DB_NAME defaults to DB_NAME at
# compose-level if unset. AGENT_DB_HOST is forced to `postgres` inside
# compose; set to `localhost` when running the agent on the host.
AGENT_DB_USER=agent_writer
AGENT_DB_PASSWORD=
AGENT_DB_NAME=

# MCP HTTP transport endpoint + bearer token (ADR 0038 + M9 auth).
# Inside compose, `bot-mcp` resolves over the service network on its
# bound port — host-exposed only in dev. The bearer is minted via the
# engine CLI: `pnpm --filter @bot/engine auth mint-token --aud mcp --sub agent --ttl 7d`.
AGENT_MCP_URL=http://bot-mcp:5434/jsonrpc
AGENT_MCP_BEARER=

# Vercel AI Gateway (ADR 0037). The gateway enforces per-run cost caps;
# the agent additionally checks the cap before each provider call.
AI_GATEWAY_URL=
AI_GATEWAY_API_KEY=
AI_GATEWAY_MAX_USD_PER_RUN=2.00

# ISO week the loop runs against (e.g., `2026-W21`). Empty = the agent
# computes it from the current UTC date. Set explicitly to re-run a
# historical week deterministically — the SDF's UNIQUE constraint on
# (parent_version_id, week_iso) makes the call idempotent.
AGENT_WEEK_ISO=

# Report output directory (markdown + JSON). Defaults to /app/reports
# inside the container; compose mounts ./reports/agent on the host.
AGENT_REPORT_DIR=/app/reports

# Optional — git commit SHA stamped into agent_run_history rows for
# reproducibility. Populated by CI; left blank in local dev.
GIT_SHA=
