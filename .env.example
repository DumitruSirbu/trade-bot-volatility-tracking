# =============================================================================
# Trade-bot environment template.
# Copy to `.env` and fill in real values. `.env` is gitignored — NEVER commit it.
# No real secret may ever appear here; only placeholders / safe local defaults.
#
# Dev workflow (M10+):
#   1. cp .env.example .env  (fill in EXCHANGE_*, TELEGRAM_*, AUTH_* secrets)
#   2. docker compose up --build
#   3. open http://localhost:8080  → LoginScreen → paste AUTH_BOOTSTRAP_SECRET
#   Postgres + engine + dashboard come up in order; engine waits for
#   postgres healthy, dashboard waits for engine healthy.
#
#   Adminer (DB admin UI) is OPT-IN via the `dev` profile so it's never
#   published by accident in shared environments:
#     docker compose --profile dev up -d            # brings up adminer too
#     docker compose --profile dev up -d adminer    # adminer only
#
#   Prod / CI image builds (no pretty logs, fully reproducible):
#     docker compose build --build-arg INCLUDE_DEV_LOGS=false engine
#
#   Migrations: the `engine-migrator` one-shot compose service runs
#   `typeorm migration:run` against the compiled JS DataSource and exits.
#   The engine service waits on `service_completed_successfully` before
#   booting, so a fresh `docker compose up` always lands a schema-correct DB.
#   Stand-alone host dev (`pnpm engine:dev`) still uses the existing CLI:
#     pnpm --filter @bot/engine migration:run
# =============================================================================

# -----------------------------------------------------------------------------
# Runtime
# -----------------------------------------------------------------------------
NODE_ENV=development
# Host-side port mapped to the engine container's :3000 (used for direct curl
# and the operator CLI). The dashboard NEVER addresses this — it goes through
# the in-network nginx reverse-proxy. Compose pins the in-container port to 3000.
ENGINE_PORT=3000
# Log level for the structured logger: error | warn | log | debug | verbose.
LOG_LEVEL=debug
# Number of upstream proxy hops to trust for X-Forwarded-For (0 = none).
# In compose, nginx sits in front of the engine → set to 1.
TRUST_PROXY_HOPS=1

# -----------------------------------------------------------------------------
# Database — Postgres
# Compose builds the container from DB_* below.
# Engine (TypeORM) connects via DATABASE_URL.
# When running ON THE HOST (pnpm engine:dev), host = localhost.
# When running INSIDE compose, the engine service overrides DB_HOST=postgres.
# -----------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_USER=trade_bot
DB_PASSWORD=change_me_local_only
DB_NAME=trade_bot
DATABASE_URL=postgresql://trade_bot:change_me_local_only@localhost:5432/trade_bot

# Adminer DB-inspection UI (host port → container 8080).
ADMINER_PORT=8081

# -----------------------------------------------------------------------------
# Dashboard
# -----------------------------------------------------------------------------
# Host-side port mapped to the dashboard nginx container.
DASHBOARD_PORT=8080

# -----------------------------------------------------------------------------
# Exchange — Binance USDT-M Futures (TESTNET first; least-privilege, NO withdrawals)
# Leave blank until you create restricted testnet keys. Never paste live keys here.
# -----------------------------------------------------------------------------
EXCHANGE_API_KEY=
EXCHANGE_API_SECRET=
# true = Binance testnet endpoints; false = live (only after validation).
EXCHANGE_TESTNET=true

# -----------------------------------------------------------------------------
# Telegram notifications (alert sink — outbound only)
# -----------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# -----------------------------------------------------------------------------
# Auth (M9 + M10)
# All three AUTH_* secrets MUST be set in production. In development, leaving
# AUTH_HMAC_SECRET / AUTH_BOOTSTRAP_SECRET unset will generate per-process
# random values (and emit a warning) — fine for local, fatal in prod.
# -----------------------------------------------------------------------------
# HS256 signing key for engine-issued JWTs. >= 32 bytes random hex/base64.
# Generate: `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
AUTH_HMAC_SECRET=

# Shared bootstrap secret the operator types into the dashboard LoginScreen
# to obtain a session JWT (ADR 0027). >= 32 bytes, MUST differ from
# AUTH_HMAC_SECRET (key-reuse forbidden — engine boot-fails). Treat as a
# long-lived credential: keep in a password manager, rotate manually.
AUTH_BOOTSTRAP_SECRET=

# Comma-separated scopes minted into a login-issued token (default `read,halt`).
# `admin` is rejected at boot — admin tokens are CLI-issued only (ADR 0027 §2.2).
AUTH_LOGIN_SCOPES=read,halt

# Allowed Origin values for the engine's CORS interceptor (comma-separated).
# Must include the dashboard's origin. Empty = deny all (ADR 0020 §2.3).
# Dev: include the Vite dev server too.
AUTH_CORS_ALLOWLIST=http://localhost:8080,http://localhost:5173

# Legacy / CLI bearer token. Unused by the dashboard once login lands.
API_AUTH_TOKEN=

# -----------------------------------------------------------------------------
# Kill switch defaults
# -----------------------------------------------------------------------------
# Default value of the `flattenOpenPositions` checkbox on the kill-switch
# confirm dialog. ADR 0021 §2.4 mandates `false` — overriding to `true`
# changes server semantics and requires an ADR amendment.
KILL_SWITCH_FLATTEN_DEFAULT=false

# -----------------------------------------------------------------------------
# Risk limits — conservative defaults. Live starts at the most restricted profile.
# -----------------------------------------------------------------------------
# Architectural max is 3; live starts at 1.
MAX_OPEN_POSITIONS=1
# Max notional exposure per coin (USDT).
MAX_EXPOSURE_PER_COIN_USDT=100
# Daily realized-loss limit (USDT) — halts new entries when breached.
DAILY_LOSS_LIMIT_USDT=50
# Weekly realized-loss limit (USDT).
WEEKLY_LOSS_LIMIT_USDT=200
# Net same-direction exposure ceiling across symbols (USDT).
MAX_SAME_DIRECTION_EXPOSURE_USDT=200
# Cooldown after a losing trade before re-entry is allowed (milliseconds).
COOLDOWN_AFTER_LOSS_MS=900000
# Total account capital allocated to the bot (USDT). Live starts at 500–1000.
ACCOUNT_CAPITAL_USDT=500

# -----------------------------------------------------------------------------
# Strategy
# -----------------------------------------------------------------------------
# Active strategy_versions.id the engine runs (ADR 0003 §7). 1 = v0 no-trade baseline.
# Switching the active version is a config change + restart — no code change.
ACTIVE_STRATEGY_VERSION_ID=1

# Execution mode: dry-run | live (controls whether the ExecutionModule
# actually hits the exchange order API — ADR 0011).
EXECUTION_MODE=dry-run
