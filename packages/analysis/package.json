        "lint": "eslint .",
        "typecheck": "tsc --noEmit",
        "test": "jest"
    },
    "dependencies": {
        "@bot/shared": "workspace:^",
        "decimal.js": "10.6.0",
        "pg": "8.21.0",
        "typeorm": "1.0.0"
    },
    "devDependencies": {
        "@types/jest": "29.5.14",
        "@types/node": "22.19.19",
        "jest": "29.7.0",
        "ts-jest": "29.2.5",
        "typescript": "5.9.3"
    }
}
