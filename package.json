{
    "name": "trade-bot",
    "version": "0.0.0",
    "private": true,
    "description": "Crypto volatility-tracking trading bot — VWAP-deviation spike detector with flow classification and a central risk gate.",
    "packageManager": "pnpm@9.15.9",
    "engines": {
        "node": ">=22"
    },
    "scripts": {
        "build": "pnpm -r build",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier --check .",
        "format:fix": "prettier --write .",
        "test": "pnpm -r test",
        "dev": "pnpm -r --parallel dev",
        "engine:dev": "pnpm --filter @bot/engine dev",
        "dashboard:dev": "pnpm --filter @bot/dashboard dev"
    },
    "devDependencies": {
        "@eslint/js": "9.39.4",
        "@types/node": "22.19.19",
        "@typescript-eslint/eslint-plugin": "8.59.4",
        "@typescript-eslint/parser": "8.59.4",
        "eslint": "9.39.4",
        "eslint-config-prettier": "10.1.8",
        "eslint-plugin-prettier": "5.5.5",
        "prettier": "3.8.3",
        "typescript": "5.9.3"
    }
}
