# Test DB contract — copy to .env.test (gitignored) before running tests.
# NEVER reuse soak or production credentials here.
TEST_DB_PORT=6900
TEST_DB_USER=trade_bot_test
TEST_DB_PASSWORD=test_only_change_me
TEST_DB_NAME=trade_bot_test
TEST_DATABASE_URL=postgresql://trade_bot_test:test_only_change_me@localhost:6900/trade_bot_test
MIGRATION_TEST_DB_URL=postgresql://trade_bot_test:test_only_change_me@localhost:6900/trade_bot_migration_test

# M17 — automated DB backup. MUST stay false in test/CI (review M1) so the test
# engine never spawns pg_dump against the ephemeral 6900 DB. The remaining
# DB_BACKUP_* vars are irrelevant while disabled; defaults shown for reference.
DB_BACKUP_ENABLED=false
DB_BACKUP_DIR=./backups
DB_BACKUP_CRON=0 3 * * *
DB_BACKUP_RETENTION=3
