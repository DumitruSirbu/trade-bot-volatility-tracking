#!/bin/sh
#
# Auto-fixing pre-commit hook (committed, zero new npm deps).
#
# Mirrors the CI `lint` and `format` jobs locally on the *staged* files so the
# Prettier/ESLint failures CI catches become impossible to commit:
#   - *.ts / *.tsx     -> prettier --write, then eslint --fix
#   - *.json/.md/.yml  -> prettier --write
# Fixed files are re-staged with `git add` so the fix lands in this commit.
#
# If `eslint --fix` still exits non-zero (an unfixable rule violation, i.e. a
# real lint error), the commit is BLOCKED. Prettier auto-fix does not fail.
#
# Uses only git + `npx prettier` + `npx eslint` (all already in the repo).
# Bypass with `git commit --no-verify` — CI remains the authoritative gate.

set -eu

# A NUL-delimited file list CANNOT be stored in a shell variable: command
# substitution strips NUL bytes, collapsing every path into one blob that
# xargs -0 then hands to prettier as a single bogus pattern (only single-file
# commits survived). So pipe `git diff -z` STRAIGHT into `xargs -0` every time
# (NULs preserved, space-safe), and use a separate plain capture purely for the
# is-anything-staged presence test, where losing the NULs is harmless.
list_ts() {
    git diff --cached --name-only --diff-filter=ACM -z -- '*.ts' '*.tsx'
}
list_doc() {
    git diff --cached --name-only --diff-filter=ACM -z -- '*.json' '*.md' '*.yml' '*.yaml'
}

has_ts=$(git diff --cached --name-only --diff-filter=ACM -- '*.ts' '*.tsx')
has_doc=$(git diff --cached --name-only --diff-filter=ACM -- '*.json' '*.md' '*.yml' '*.yaml')

# Fast path: nothing relevant staged.
if [ -z "$has_ts" ] && [ -z "$has_doc" ]; then
    exit 0
fi

# --- TypeScript: prettier --write, then eslint --fix ---
if [ -n "$has_ts" ]; then
    list_ts | xargs -0 npx prettier --write
    if ! list_ts | xargs -0 npx eslint --fix; then
        echo ""
        echo "pre-commit: ESLint found unfixable errors in staged TS files."
        echo "pre-commit: fix them and re-stage, or bypass with --no-verify."
        exit 1
    fi
    list_ts | xargs -0 git add --
fi

# --- JSON / Markdown / YAML: prettier --write only ---
if [ -n "$has_doc" ]; then
    list_doc | xargs -0 npx prettier --write
    list_doc | xargs -0 git add --
fi

exit 0
