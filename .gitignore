# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
build/
.tsbuildinfo
*.tsbuildinfo

# Compiled TypeScript test artifacts (jest --outDir or ts-jest transpile output)
apps/engine/tests/**/*.js
apps/engine/tests/**/*.js.map
apps/engine/src/**/*.js
apps/engine/src/**/*.js.map

# Vite / frontend
.vite/
.next/
.turbo/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Env
.env
.env.local
.env.*.local
!.env.example
# The .env.*.local glob does NOT match .env.test, so ignore it explicitly while
# keeping the committed template (.env.test.example) tracked.
.env.test
!.env.test.example

# OS
.DS_Store
Thumbs.db

# Editors
.vscode/
.idea/
*.swp
*.swo

# Testing / coverage
coverage/
.nyc_output/

# Docker
.docker/

# Claude Code — personal/local settings
.claude/settings.local.json
.claude/scheduled_tasks.lock

# RTK — local filter overrides
.rtk/

# Misc
*.tgz
.pnpm-debug.log

# Backtest artefact output
apps/engine/var/

# M17 — automated DB-backup output (default DB_BACKUP_DIR=./backups). Never
# commit gzipped dumps; they contain soak calibration data.
backups/

# Manual rule-9 pg_dump backups (root). Never commit — soak calibration data.
backup_*.sql.gz

# backtest sweep raw JSON reports (markdown summaries are committed)
docs/analysis/.runs/
